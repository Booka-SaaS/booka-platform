generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CLIENTE
  PROFISSIONAL
}

enum ModalidadeProfissional {
  ONLINE
  PRESENCIAL
  HIBRIDO
}

enum TipoVendedor {
  AUTONOMO
  EMPRESA
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

enum OrigemAgendamento {
  PUBLICO
  PAINEL
}

model Usuario {
  id                 String              @id @default(uuid()) @db.Uuid
  nome               String
  email              String              @unique
  passwordHash       String
  role               UserRole
  ativo              Boolean             @default(true)
  imagemUrl          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  perfilProfissional PerfilProfissional?
  loja               Loja?
  passwordResetTokens PasswordResetToken[]
  notificacoes       Notificacao[]
}

model PerfilProfissional {
  id                  String                 @id @default(uuid()) @db.Uuid
  usuarioId           String                 @unique @db.Uuid
  nomeExibicao        String
  profissao           String
  bio                 String?
  imagemUrl           String?
  categoriaPrincipal  String
  modalidadePrincipal ModalidadeProfissional
  tipoVendedor        TipoVendedor
  cidade              String?
  publicado           Boolean                @default(false)
  rating              Float                  @default(5)
  avaliacoesCount     Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  usuario             Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  loja                Loja?
}

model Loja {
  id                   String                   @id @default(uuid()) @db.Uuid
  usuarioId            String                   @unique @db.Uuid
  perfilProfissionalId String?                  @unique @db.Uuid
  nome                 String
  slug                 String                   @unique
  email                String?
  telefone             String?
  endereco             String?
  cep                  String?
  logradouro           String?
  numero               String?
  bairro               String?
  complemento          String?
  estado               String?
  cidade               String?
  descricao            String?
  imagemUrl            String?
  onboardingConcluido  Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  usuario              Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfilProfissional   PerfilProfissional?      @relation(fields: [perfilProfissionalId], references: [id], onDelete: SetNull)
  servicos             Servico[]
  clientes             Cliente[]
  agendamentos         Agendamento[]
  disponibilidades     DisponibilidadeSemanal[]
  bloqueios            BloqueioAgenda[]

  @@index([nome])
}

model Servico {
  id             String        @id @default(uuid()) @db.Uuid
  lojaId         String        @db.Uuid
  nome           String
  descricao      String?
  duracaoMinutos Int
  precoCentavos  Int
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  loja           Loja          @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  agendamentos   Agendamento[]

  @@unique([lojaId, nome])
  @@index([lojaId, ativo])
}

model Cliente {
  id           String        @id @default(uuid()) @db.Uuid
  lojaId       String        @db.Uuid
  nome         String
  email        String?
  telefone     String
  anotacoes    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  loja         Loja          @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@unique([lojaId, telefone])
  @@index([lojaId, nome])
}

model Agendamento {
  id          String            @id @default(uuid()) @db.Uuid
  lojaId      String            @db.Uuid
  clienteId   String            @db.Uuid
  servicoId   String            @db.Uuid
  inicio      DateTime
  fim         DateTime
  status      StatusAgendamento @default(PENDENTE)
  origem      OrigemAgendamento @default(PAINEL)
  observacoes String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  loja        Loja              @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  cliente     Cliente           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  servico     Servico           @relation(fields: [servicoId], references: [id], onDelete: Restrict)

  @@index([lojaId, inicio])
  @@index([clienteId])
  @@index([servicoId])
}

model DisponibilidadeSemanal {
  id               String   @id @default(uuid()) @db.Uuid
  lojaId           String   @db.Uuid
  diaSemana        Int
  horaInicio       String
  horaFim          String
  intervaloMinutos Int
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  loja             Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@unique([lojaId, diaSemana])
  @@index([lojaId, diaSemana])
}

model BloqueioAgenda {
  id        String   @id @default(uuid()) @db.Uuid
  lojaId    String   @db.Uuid
  inicio    DateTime
  fim       DateTime
  motivo    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loja      Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([lojaId, inicio, fim])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @db.Uuid
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([usuarioId])
}

enum TipoNotificacao {
  AGENDAMENTO
  SISTEMA
  LEMBRETE
}

model Notificacao {
  id        String           @id @default(uuid()) @db.Uuid
  usuarioId String           @db.Uuid
  eventoId  String?          @unique
  titulo    String
  mensagem  String
  tipo      TipoNotificacao  @default(SISTEMA)
  lida      Boolean          @default(false)
  createdAt DateTime         @default(now())
  usuario   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lida])
  @@index([usuarioId, createdAt])
}
