{
  "name": "booka-backend-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Backend V2 do Booka, reconstruido a partir do frontend atual.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:core": "tsx watch src/server.ts",
    "dev:gateway": "tsx watch services/api-gateway/server.ts",
    "dev:notifications": "tsx watch services/notification-service/src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:core": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:gateway": "node dist/services/api-gateway/server.js",
    "start:notifications": "node dist/services/notification-service/src/main.js",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand -c jest.integration.config.cjs",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@prisma/client": "^6.7.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "http-proxy-middleware": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.4",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.4.2",
    "prisma": "^6.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
